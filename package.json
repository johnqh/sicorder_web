{
  "name": "sicorder_web",
  "private": true,
  "version": "0.0.7",
  "type": "module",
  "scripts": {
    "generate:cf-env": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-cloudflare-env.ts -o /tmp/generate-cloudflare-env.ts && bunx tsx /tmp/generate-cloudflare-env.ts",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "dev": "bun run process:static && vite",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "build": "bun run process:static && bun run seo:fetch && node node_modules/.cache/workflows/generate-seo-assets.mjs public && tsc -b && vite build && node node_modules/.cache/workflows/generate-seo-assets.mjs dist",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "brand": "bun scripts/make-brand-assets.ts",
    "localize": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && WHISPERLY_API_KEY=$(grep -h '^WHISPERLY_API_KEY=' ~/.develop/.keys ~/.keys ~/.keys.txt 2>/dev/null | head -1 | cut -d= -f2-) node $SCRIPT ./public/locales https://api.whisperly.dev/api/v1/translate/jie9cytr/starter --word-limit 40 && rm -f $SCRIPT && prettier public/locales --write",
    "localized": "node scripts/localization_verify.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@heroicons/react": "~2.2.0",
    "@radix-ui/react-alert-dialog": "~1.2.1",
    "@radix-ui/react-dialog": "~1.3.1",
    "@radix-ui/react-label": "~2.1.17",
    "@radix-ui/react-select": "~2.4.1",
    "@radix-ui/react-slot": "~1.5.0",
    "@radix-ui/react-switch": "~1.4.1",
    "@radix-ui/react-tabs": "~1.2.1",
    "@sudobility/building_blocks": "^0.0.344",
    "@sudobility/components": "^5.3.47",
    "@sudobility/design": "^1.1.66",
    "@sudobility/di": "^1.5.82",
    "@sudobility/seo_lib": "^0.0.49",
    "@sudobility/types": "^1.9.76",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "firebase": "~12.19.0",
    "i18next": "~26.3.1",
    "i18next-browser-languagedetector": "~8.2.1",
    "i18next-http-backend": "~4.0.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-helmet-async": "~3.0.0",
    "react-i18next": "~17.0.8",
    "react-router-dom": "~7.18.4",
    "tailwind-merge": "~3.7.0",
    "web-vitals": "~6.1.1"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/bun": "~1.4.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~5.1.2",
    "autoprefixer": "~10.6.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~17.13.0",
    "postcss": "~8.5.31",
    "prettier": "~3.9.10",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~7.3.7",
    "playwright": "~1.64.1",
    "tsx": "~4.23.15"
  },
  "license": "BUSL-1.1",
  "author": "Sudobility Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnqh/sicorder_web.git"
  }
}
